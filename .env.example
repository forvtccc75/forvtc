# ============ FORVTC — variables d'environnement ============
# NE JAMAIS COMMITTER LE .env RÉEL. Sur Vercel : Settings → Environment Variables.

# --- Obligatoire partout ---
# Secret de session (générer : openssl rand -hex 32)
SESSION_SECRET=

# URL publique du site (prod : https://votre-domaine.fr) — utilisée par Stripe
# (success/cancel URLs), les emails, le sitemap et le SEO canonical.
NEXT_PUBLIC_BASE_URL=

# --- Base de données ---
# Production (Vercel) : chaîne PostgreSQL (Neon / Vercel Postgres / Supabase…).
# Vide en dev => PGlite local (./pgdata), aucun service requis.
DATABASE_URL=

# --- Stockage fichiers (production Vercel : OBLIGATOIRE, le disque est éphémère) ---
# Créé automatiquement en connectant un store Vercel Blob au projet.
BLOB_READ_WRITE_TOKEN=

# --- Bootstrap admin (temporaire) ---
# Jeton à usage unique pour créer le PREMIER admin via POST /api/setup-admin
# (générer : openssl rand -hex 24). La route se désactive dès qu'un admin existe.
# SUPPRIMEZ cette variable de Vercel après création de l'admin.
ADMIN_SETUP_TOKEN=

# --- Stripe (boosts d'annonces ; paiements de location à venir) ---
# Tant que vide : les paiements sont affichés comme NON ACTIFS (jamais simulés).
# Clé secrète API : dashboard.stripe.com → Developers → API keys (sk_test_... puis sk_live_...)
STRIPE_SECRET_KEY=
# Secret de signature du webhook : Developers → Webhooks → endpoint → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- Emails transactionnels Brevo (actifs dès que renseignés) ---
# Clé API : app.brevo.com → Settings → SMTP & API → API Keys (xkeysib-...)
BREVO_API_KEY=
# Expéditeur : adresse validée dans Brevo (Senders & Domains) — idéalement sur votre domaine
EMAIL_FROM=
EMAIL_FROM_NAME=FORVTC

# --- Signature électronique avancée (adapter prêt ; embedded signing à brancher) ---
# DocuSign (JWT Grant) : developers.docusign.com → Apps & Keys
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# Clé privée RSA de l'app DocuSign (contenu PEM, retours ligne échappés \n)
DOCUSIGN_PRIVATE_KEY=
# Base API : https://demo.docusign.net/restapi (sandbox) puis https://eu.docusign.net/restapi
DOCUSIGN_BASE_URL=
# Alternative française : Yousign
YOUSIGN_API_KEY=

# --- API Sirene (INSEE) ---
# RIEN À CONFIGURER : la vérification SIRET utilise l'API publique gratuite
# recherche-entreprises.api.gouv.fr (données Sirene INSEE, sans clé).

# --- Géocodage / carte ---
# RIEN À CONFIGURER : géocodage BAN (api-adresse.data.gouv.fr, gratuit, sans clé)
# + carte MapLibre avec tuiles OpenStreetMap (gratuit, sans clé).
